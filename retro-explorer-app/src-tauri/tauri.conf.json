{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "retroachievements-explorer",
  "version": "0.1.0",
  "identifier": "com.danxexe.retroachievements-explorer",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": false
      }
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../src/pages/": "pages/"
    }
  }
}
