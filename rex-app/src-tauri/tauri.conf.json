{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "retro-explorer",
  "version": "0.1.0",
  "identifier": "com.danxexe.retro-explorer",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "fullscreen": false,
        "width": 800,
        "height": 600,
        "resizable": true,
        "title": "REX",
        "url": "rex://localhost/start.html"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": false
      }
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:rex.db"]
    }
  }
}
